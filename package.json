{
  "name": "bihupp-js",
  "version": "1.0.0",
  "description": "TypeScript/JavaScript library for BIHUPP10 payment QR payloads for Bosnia and Herzegovina.",
  "license": "MIT",
  "author": "Luka Gligorevic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gligor99/bihupp-js.git"
  },
  "homepage": "https://github.com/gligor99/bihupp-js#readme",
  "bugs": {
    "url": "https://github.com/gligor99/bihupp-js/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0",
    "zod": "^3.23.0"
  }
}
