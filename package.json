{
  "name": "bihupp-js",
  "version": "1.0.0",
  "description": "TypeScript/JavaScript library for BIHUPP10 payment QR payloads for Bosnia and Herzegovina.",
  "keywords": [
    "bihupp",
    "bihupp10",
    "qr",
    "qr-code",
    "payment",
    "payment-slip",
    "uplatnica",
    "bank",
    "bosnia",
    "bosnia-and-herzegovina",
    "bih",
    "zod",
    "typescript"
  ],
  "license": "MIT",
  "author": "Luka Gligorevic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gligor99/bihupp-js.git"
  },
  "homepage": "https://github.com/gligor99/bihupp-js#readme",
  "bugs": {
    "url": "https://github.com/gligor99/bihupp-js/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "zod": [
        "./dist/zod.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./zod": {
      "import": {
        "types": "./dist/zod.d.mts",
        "default": "./dist/zod.mjs"
      },
      "require": {
        "types": "./dist/zod.d.ts",
        "default": "./dist/zod.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint:pkg": "publint && attw --pack",
    "prepublishOnly": "npm run typecheck && npm run test:run && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "publint": "^0.3.25",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
